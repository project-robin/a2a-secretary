│   ├── tdd-workflow/
│   ├── continuous-learning-v2/
│   └── ...
├── commands/                # Slash commands
│   ├── plan.md
│   ├── tdd.md
│   └── ...
├── rules/                   # Always-follow guidelines
│   ├── common/
│   │   ├── coding-style.md
│   │   └── testing.md
│   ├── typescript/
│   └── ...
├── hooks/                   # Event-driven automation
│   └── hooks.json
