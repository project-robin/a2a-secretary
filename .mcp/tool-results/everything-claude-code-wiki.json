    Instincts["instincts/"]
    InstinctFiles["*.md instinct files"]
    
    Config["Configuration Files"]
    Aliases["session-aliases.json"]
    PMConfig["package-manager.json"]
    
    ClaudeDir --> Sessions
    Sessions --> SessionFiles
    Sessions --> CompactLog
    
    ClaudeDir --> Skills
    Skills --> Learned
    Learned --> LearnedFiles
    
    ClaudeDir --> Homunculus
    Homunculus --> Projects
