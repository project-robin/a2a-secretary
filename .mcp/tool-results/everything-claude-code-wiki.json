## Usage Examples

### List Recent Sessions

```javascript
const { getAllSessions } = require('./scripts/lib/session-manager');

// Get 10 most recent sessions
const result = getAllSessions({ limit: 10, offset: 0 });

console.log(`Found ${result.total} sessions`);
console.log(`Showing ${result.sessions.length} sessions`);
console.log(`More available: ${result.hasMore}`);

result.sessions.forEach(session => {
  console.log(`${session.date} - ${session.shortId} (${session.size} bytes)`);
});
```

### Load Session with Full Context

```javascript
const { getSessionById } = require('./scripts/lib/session-manager');

const session = getSessionById('abcd1234', true);

if (session) {
  console.log(`Title: ${session.metadata.title}`);
  console.log(`Completed: ${session.stats.completedItems}`);
  console.log(`In Progress: ${session.stats.inProgressItems}`);
  console.log(`Content: ${session.content.substring(0, 100)}...`);
}
```

### Filter Sessions by Date

```javascript
const { getAllSessions } = require('./scripts/lib/session-manager');

// Get all sessions from February 1, 2026
const result = getAllSessions({ 
  date: '2026-02-01',
  limit: 100 
});

console.log(`Found ${result.total} sessions on 2026-02-01`);
```

**Sources:** [scripts/lib/session-manager.js:1-442]()

