### Creating Hook Tests

Template for new hook tests:

```javascript
// In tests/hooks/hooks.test.js

if (await asyncTest('hook-name handles specific scenario', async () => {
  const testDir = createTestDir();
  try {
    const testFile = path.join(testDir, 'test.js');
    fs.writeFileSync(testFile, 'test content');

    const stdinJson = JSON.stringify({
      tool_input: { file_path: testFile }
    });

    const result = await runScript(
      path.join(scriptsDir, 'hook-name.js'),
      stdinJson
    );

    assert.strictEqual(result.code, 0, 'Should exit 0');
    assert.ok(result.stderr.includes('expected message'));
    assert.ok(result.stdout.includes('tool_input')); // passthrough
  } finally {
    cleanupTestDir(testDir);
  }
})) passed++; else failed++;
```

