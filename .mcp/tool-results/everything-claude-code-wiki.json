## Example: Complete Custom Hook

Here's a complete example that demonstrates all best practices:

**File:** `scripts/hooks/check-test-coverage.js`

```javascript
/**
 * check-test-coverage.js
 * PostToolUse hook that warns when test files are missing for new code files
 */

const fs = require('fs');
const path = require('path');

let data = '';

process.stdin.on('data', chunk => {
  data += chunk;
});

process.stdin.on('end', () => {
  try {
    const input = JSON.parse(data);
    const filePath = input.tool_input?.file_path || '';
    
    // Only check source files
    if (/\/(src|lib)\/.*\.(js|ts)$/.test(filePath)) {
      // Skip test files themselves
      if (!/\.(test|spec)\.(js|ts)$/.test(filePath)) {
        // Determine expected test file path
        const testPath = filePath.replace(/(\.js|\.ts)$/, '.test$1');
        const altTestPath = filePath.replace(/\/(src|lib)\//, '/__tests__/');
        
        if (!fs.existsSync(testPath) && !fs.existsSync(altTestPath)) {
          console.error('[Hook] ⚠️  No test file found for ' + path.basename(filePath));
          console.error('[Hook] Expected: ' + testPath);
          console.error('[Hook] Or: ' + altTestPath);
          console.error('[Hook] Consider adding tests to maintain coverage');
        }
      }
    }
  } catch (err) {
    // Silently handle errors - hook failure shouldn't break workflow
  }
  
  // REQUIRED: Pass through original input
  console.log(data);
  
  // Exit code 0 (default) - this is a warning, not a blocker
});
```

**Registration in hooks.json:**

```json
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/check-test-coverage.js\"",
            "description": "Warn when test files are missing for new code"
          }
        ]
      }
    ]
  }
}
```

This hook:
- ✅ Reads stdin in chunks
- ✅ Parses JSON safely with try/catch
- ✅ Performs meaningful validation
- ✅ Outputs clear messages to stderr
- ✅ Passes through original data to stdout
- ✅ Uses exit code 0 (warning only)
- ✅ Uses `${CLAUDE_PLUGIN_ROOT}` for portability
- ✅ Includes descriptive comment header

Sources: [scripts/hooks/post-edit-console-warn.js:1-76](), [hooks/hooks.json:115-144]()

