## Exit Codes and Blocking Behavior

```mermaid
flowchart TD
    preToolUse["PreToolUse Hook Executes"]
    postToolUse["PostToolUse Hook Executes"]
    
    preToolUse --> exitCheck{"Exit Code?"}
    exitCheck -->|0| allow["Tool Executes"]
    exitCheck -->|2| block["Tool BLOCKED"]
    exitCheck -->|1| error["Error logged,<br/>tool may be blocked"]
    
    allow --> toolRuns["Tool Runs"]
    toolRuns --> postToolUse
    
    postToolUse --> postCheck{"Exit Code?"}
    postCheck -->|0| continue["Continue"]
    postCheck -->|"non-zero"| warn["Warning logged,<br/>execution continues"]
    
    block --> userNotified["User sees stderr message"]
```

**Sources:** [tests/integration/hooks.test.js:284-313](), [tests/hooks/hooks.test.js:275-313]()

### Blocking Example

```javascript
// Block dangerous git push without confirmation
let data = '';
process.stdin.on('data', c => data += c);
process.stdin.on('end', () => {
  try {
    const input = JSON.parse(data);
    const cmd = input.tool_input?.command || '';
    
    if (/git push.*--force/.test(cmd)) {
      console.error('[Hook] BLOCKED: Force push detected');
      console.error('[Hook] Use --force-with-lease instead');
      process.exit(2); // EXIT CODE 2 = BLOCK
    }
  } catch {}
  console.log(data);
  // Exits with 0 if not blocked
});
```

Sources: [hooks/hooks.json:9-14](), [tests/integration/hooks.test.js:240-273]()

