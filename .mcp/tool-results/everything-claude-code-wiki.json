~/.claude/sessions/YYYY-MM-DD-<random-id>-session.tmp
~/.claude/sessions/session-aliases.json

# Continuous learning v2 (created by PreToolUse/PostToolUse hooks)
~/.claude/homunculus/observations.jsonl
~/.claude/homunculus/observations.archive/YYYY-MM-DD.jsonl

