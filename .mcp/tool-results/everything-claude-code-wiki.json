    end
    
    subgraph "Event Registration"
        PreTool["tool.execute.before"]
        PostTool["tool.execute.after"]
        SessionCreate["session.created"]
        SessionDelete["session.deleted"]
        FileEdit["file.edited"]
        FileWatch["file.watcher.updated"]
        SessionIdle["session.idle"]
        MsgUpdate["message.updated"]
    end
    
    subgraph "Custom Tools"
        RunTests["run-tests"]
        CheckCoverage["check-coverage"]
        SecurityAudit["security-audit"]
    end
    
    Manifest --> Agents
    Manifest --> Commands
    Manifest --> Skills
    Manifest --> Hooks
    Manifest --> Tools
    
    Hooks --> PreTool
    Hooks --> PostTool
    Hooks --> SessionCreate
    Hooks --> SessionDelete
