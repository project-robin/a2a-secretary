## Hook Implementation Patterns

### Pattern 1: Read File Hook (PostToolUse)

Check file contents after Edit/Write operations:

```javascript
const fs = require('fs');

let data = '';
process.stdin.on('data', c => data += c);
process.stdin.on('end', () => {
  try {
    const input = JSON.parse(data);
    const filePath = input.tool_input?.file_path || '';
    
    if (/\.(js|ts)$/.test(filePath)) {
      if (fs.existsSync(filePath)) {
        const content = fs.readFileSync(filePath, 'utf8');
        
        if (/console\.log/.test(content)) {
          console.error('[Hook] WARNING: console.log detected');
          console.error(`[Hook] File: ${filePath}`);
        }
      }
    }
  } catch {}
  console.log(data);
});
```

Sources: [scripts/hooks/post-edit-console-warn.js:1-76]()

### Pattern 2: Command Analysis Hook (PreToolUse)

Analyze Bash commands before execution:

```javascript
let data = '';
process.stdin.on('data', c => data += c);
process.stdin.on('end', () => {
  try {
    const input = JSON.parse(data);
    const cmd = input.tool_input?.command || '';
    
    // Pattern matching on command
    if (/npm run dev|pnpm dev|yarn dev/.test(cmd)) {
      if (!process.env.TMUX) {
        console.error('[Hook] Consider running in tmux for persistence');
        console.error('[Hook] tmux new -s dev');
      }
    }
  } catch {}
  console.log(data);
});
```

Sources: [hooks/hooks.json:16-24]()

### Pattern 3: State Tracking Hook (SessionStart/SessionEnd)

Maintain state across sessions:

```javascript
const fs = require('fs');
const path = require('path');
const os = require('os');

const stateFile = path.join(os.homedir(), '.claude', 'hook-state.json');

// Load previous state
let state = { sessionCount: 0 };
if (fs.existsSync(stateFile)) {
  state = JSON.parse(fs.readFileSync(stateFile, 'utf8'));
}

state.sessionCount++;
state.lastSession = new Date().toISOString();

// Save updated state
fs.writeFileSync(stateFile, JSON.stringify(state, null, 2));

console.error(`[Hook] Session #${state.sessionCount}`);
```

Sources: [scripts/hooks/session-start.js:1-150](), [scripts/hooks/session-end.js:1-200]()

