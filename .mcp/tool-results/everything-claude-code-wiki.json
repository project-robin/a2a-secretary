        IterativeRetrieval["iterative-retrieval"]
        TDDWorkflow["tdd-workflow"]
        VerificationLoop["verification-loop"]
    end
    
    subgraph Storage["Knowledge Storage"]
        MCPSettings["~/.claude/settings.json
        (MCP servers)"]
        SkillsDir["~/.claude/skills/
        (Installed skills)"]
        PkgRegistry["Package registries
        (npm, PyPI)"]
