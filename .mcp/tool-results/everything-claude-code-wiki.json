    end

    subgraph "Agent Layer (agents/)"
        PlannerAgent["planner.md<br/>model: opus<br/>tools: Read,Write,Edit"]
        TddAgent["tdd-guide.md<br/>model: sonnet<br/>tools: Read,Write,Edit,Bash"]
        ReviewAgent["code-reviewer.md<br/>model: opus<br/>tools: Read,Grep,Glob,Bash"]
    end

    subgraph "Skill Layer (skills/)"
        TddSkill["tdd-workflow/SKILL.md<br/>RED→GREEN→IMPROVE"]
