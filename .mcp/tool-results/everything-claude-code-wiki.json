// Simplified logic from hooks.json:10
if (process.platform !== 'win32' && 
    /(npm run dev|pnpm dev|yarn dev|bun run dev)/.test(cmd)) {
  console.error('[Hook] BLOCKED: Dev server must run in tmux');
  process.exit(2);  // Block execution
}
```

